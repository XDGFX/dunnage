{
  "name": "dunnage",
  "version": "0.3.0",
  "private": true,
  "description": "Printable holders that keep things still in a drawer, even on a rough road",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dunnage": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:lib && bun run build:site",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "schema": "bun scripts/schema.ts",
    "test": "bun --bun vitest run",
    "validate": "bun src/cli/main.ts check fixtures/*.yml"
  },
  "dependencies": {
    "manifold-3d": "3.5.4",
    "three": "0.186.1",
    "typebox": "1.3.34",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
